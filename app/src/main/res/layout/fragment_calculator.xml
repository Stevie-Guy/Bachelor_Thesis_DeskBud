<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

<!--        Titlu-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titlu_calculator"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1e2939"
            android:textAlignment="center"
            android:layout_marginBottom="12dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#eff7ff"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#bedbff"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_greutate"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#374151"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="#fff">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tiet_greutate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/placeholder_greutate"
                            android:inputType="numberDecimal"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_alege_sex"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#374151"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_calculator_barbat"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="14dp"
                            android:text="@string/buton_barbat"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:backgroundTint="#2b7fff"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#2b7fff"
                            app:strokeWidth="1dp"
                            app:cornerRadius="10dp"/>

                        <Button
                            android:id="@+id/btn_calculator_femeie"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingVertical="14dp"
                            android:text="@string/buton_femeie"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:backgroundTint="#FFFFFF"
                            android:textColor="#2b7fff"
                            app:cornerRadius="10dp"
                            app:strokeColor="#2b7fff"
                            app:strokeWidth="1dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btn_info_formula"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:src="@android:drawable/ic_dialog_info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/descriere_btn_info_calculator"
                android:scaleType="fitCenter"
                app:tint="#2b7fff"/>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_disclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/warning_background"
            android:padding="12dp"
            android:text="Disclaimer: aceste informații sunt folosite strict pentru calcularea goal-ului personal și nu vor fi distribuite!"
            android:textAlignment="center"
            android:textColor="#894b00"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btn_calculeaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingVertical="14dp"
            android:text="@string/btn_calculeaza"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2b7fff"
            android:textColor="#FFFFFF"
            app:cornerRadius="12dp"
            android:layout_marginBottom="14dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_rezultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#eff7ff"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#bedbff"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_rezultat_calculator"
                    android:textSize="16sp"
                    android:textColor="#4a5565"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_rezultat_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rezultat_calculator"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#155dfc"/>

                <TextView
                    android:id="@+id/tv_rezultat_goal_ml"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rezultat_calculator_ml"
                    android:textSize="14sp"
                    android:textColor="#6a7282"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>

</ScrollView>